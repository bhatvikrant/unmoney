{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx convex deploy --cmd 'npm run build' && node scripts/convex-preview-env.mjs",
  "redirects": [
    {
      "source": "/((?!sw\\.js$|googlee7fb4d922eff4e5f\\.html$).*)",
      "has": [
        {
          "type": "host",
          "value": "unmoney.vercel.app"
        }
      ],
      "destination": "https://unmoney.vikrantbhat.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
